NFSE_MODE=cloud
NFSE_DB_SCHEMA=nfse_app
# Use a conexão do pooler transacional do projeto, com TLS. Apenas no servidor.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST_POOLER:6543/postgres?sslmode=require
# Origens exatas, sem caminho ou barra final. Atualize após obter a URL da Vercel.
APP_HOSTS=SEU_PROJETO.vercel.app
APP_ORIGINS=https://SEU_PROJETO.vercel.app
# Código aleatório longo para criar o primeiro administrador. Nunca usar VITE_/NEXT_PUBLIC_.
BOOTSTRAP_TOKEN=
